# ─────────────────────────────────────────────────────────────────────────────
# ServiceFlow Pro — variáveis de ambiente
# Copie este arquivo para .env e preencha com os seus dados.
# NUNCA commite o arquivo .env no controle de versão.
# ─────────────────────────────────────────────────────────────────────────────

# Conexão com o PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/serviceflow

# Chave secreta para sessões Flask (cookies assinados)
# Gere uma chave segura: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Em produção com múltiplos processos, use um backend compartilhado, como Redis.
RATELIMIT_STORAGE_URI=memory://

# Porta do servidor (opcional — padrão: 5000)
# PORT=5000
